[Unit]
Description=Daily registry refresh for the liquidation bot (exits applied live, markets to review)
Documentation=file:tools/registry/daily_refresh.py
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/liq
# MAINNET_RPC_URL must be an endpoint with Alchemy's transfer index: the
# unwrap gates find real holders with alchemy_getAssetTransfers. Keep it out
# of git:
#   install -m 600 /dev/null /opt/liq/discovery.env
#   echo 'MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/<key>' > /opt/liq/discovery.env
EnvironmentFile=/opt/liq/discovery.env
# The Pendle probes are read from contracts/out: run `forge build` in
# /opt/liq/contracts once (and after pulling contract changes).
ExecStart=/usr/bin/python3 tools/registry/daily_refresh.py
# Exit changes land in registry/registry.json (atomic replace); the running
# reth-liq ExEx adds them within ~15 s. Everything else is reported in
# data/review/<date>.md for a person to decide.
TimeoutStartSec=6h
# Stay out of the way of Reth and the hot thread.
Nice=10
IOSchedulingClass=idle
