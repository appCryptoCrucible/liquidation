{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liquidator.local/registry/schema.json",
  "title": "Liquidator chain registry",
  "description": "Static chain-derived decimals, token order, fee tiers, aggregator, and addresses (REGISTRY.md §2). Boot assertion re-reads decimals/symbol/token0/token1/fee/oracle decimals/aggregator from chain (REGISTRY.md §4c).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chain_id",
    "generated_at_block",
    "tokens",
    "protocols",
    "oracles",
    "pools",
    "flash_sources",
    "routers"
  ],
  "properties": {
    "chain_id": {
      "type": "integer",
      "const": 1,
      "description": "EIP-155 chain id. This project is Ethereum mainnet only (D01)."
    },
    "generated_at_block": {
      "type": "integer",
      "minimum": 0,
      "description": "Block the derivation read from. Not boot-checkable cheaply."
    },
    "tokens": {
      "type": "object",
      "description": "ERC-20 (and bytes32-metadata) tokens, keyed by address.",
      "additionalProperties": false,
      "patternProperties": {
        "^0x[0-9a-f]{40}$": { "$ref": "#/$defs/token" }
      }
    },
    "protocols": {
      "type": "object",
      "description": "Protocol markets/instances, keyed by `family:id`.",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z0-9-]+:0x[0-9a-f]+$": { "$ref": "#/$defs/protocol" },
        "^[a-z0-9-]+:[a-z0-9-]+$": { "$ref": "#/$defs/protocol" }
      }
    },
    "oracles": {
      "type": "object",
      "description": "Aggregator proxies, keyed by proxy address.",
      "additionalProperties": false,
      "patternProperties": {
        "^0x[0-9a-f]{40}$": { "$ref": "#/$defs/oracle" }
      }
    },
    "pools": {
      "type": "object",
      "description": "DEX pools. token0/token1 are the pool's on-chain order.",
      "additionalProperties": false,
      "patternProperties": {
        "^0x[0-9a-f]{40}$": { "$ref": "#/$defs/pool" }
      }
    },
    "flash_sources": {
      "type": "object",
      "description": "Flash-loan singletons the index binds (GUIDE 07 \u00a73a), keyed by address: kind singleton (Morpho Blue), pool_manager (Uniswap V4), dss_flash and mcd_end (Sky, from the Chainlog). Aave/Spark pools and V3 pools are bound from protocols and pools."
    },
    "routers": {
      "type": "object",
      "description": "Allowlisted routers (Curve). Balancer is out of scope (D08)."
    }
  },
  "$defs": {
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{40}$"
    },
    "bytes32": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "token": {
      "type": "object",
      "required": ["symbol", "decimals"],
      "properties": {
        "symbol": { "type": ["string", "null"] },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 255 },
        "quirks": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "no_return_data",
              "approve_nonzero_reverts",
              "fee_on_transfer",
              "rebasing",
              "low_decimals",
              "nonstandard_metadata",
              "symbol_collision"
            ]
          }
        },
        "symbol_collision": {
          "type": "object",
          "required": ["claims", "canonical", "source"],
          "properties": {
            "claims": { "type": "string" },
            "canonical": { "$ref": "#/$defs/address" },
            "source": { "type": "string" }
          },
          "additionalProperties": false
        },
        "unwrap": {
          "type": "object",
          "description": "A wrapper the Executor unwraps instantly (swap venue 5) into another registry token (tools/registry/discover_unwraps.py).",
          "required": ["kind", "into"],
          "properties": {
            "kind": { "type": "string", "enum": ["erc4626", "pendle_pt", "curve_lp", "pendle_market"] },
            "into": { "$ref": "#/$defs/address" },
            "yt": { "$ref": "#/$defs/address", "description": "pendle_pt only: PT.YT()." },
            "sy": { "$ref": "#/$defs/address", "description": "pendle_pt / pendle_market: YT.SY()." },
            "market": { "$ref": "#/$defs/address", "description": "pendle_market only: the PT's V6 market." },
            "cash_capped": { "type": "boolean", "description": "erc4626 only: redeem pays at most the vault's cash() (Euler EVK)." }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "protocol": {
      "type": "object",
      "required": ["family", "market", "deployed_block"],
      "properties": {
        "family": { "type": "string" },
        "market": {
          "oneOf": [
            { "$ref": "#/$defs/address" },
            { "$ref": "#/$defs/bytes32" }
          ]
        },
        "deployed_block": { "type": "integer", "minimum": 0 },
        "receipt_tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/address" }
        },
        "oracle_adapters": {
          "type": "array",
          "items": { "$ref": "#/$defs/address" }
        },
        "admitted": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "oracle": {
      "type": "object",
      "required": ["aggregator", "pair", "decimals", "svr"],
      "properties": {
        "aggregator": { "$ref": "#/$defs/address" },
        "pair": { "type": "string" },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 255 },
        "svr": { "type": "boolean" },
        "source": { "type": "string" }
      },
      "additionalProperties": false
    },
    "pool": {
      "type": "object",
      "required": ["venue", "token0", "token1", "fee", "factory", "deployed_block"],
      "properties": {
        "venue": { "type": "string", "enum": ["univ3", "univ4", "univ2", "curve", "curve_ng", "curve_crypto", "balancer", "fluid"] },
        "pool_id": { "$ref": "#/$defs/bytes32", "description": "balancer only: the Vault pool id; its first 20 bytes are the pool address." },
        "balancer_kind": { "type": "string", "enum": ["weighted_v1", "weighted_v4"], "description": "balancer only: the deployed WeightedPool generation." },
        "tick_spacing": { "type": "integer", "description": "univ4 only: the pool key's tickSpacing." },
        "hooks": { "$ref": "#/$defs/address", "description": "univ4 only: the pool key's hook (zero for none)." },
        "v4_id": { "$ref": "#/$defs/bytes32", "description": "univ4 only: keccak256(abi.encode(PoolKey)); the entry's key is its low 20 bytes." },
        "native": { "type": "boolean", "description": "univ4: currency0 is native ETH, named WETH in token0. fluid: the coin named WETH is native ETH." },
        "token0": { "$ref": "#/$defs/address" },
        "token1": { "$ref": "#/$defs/address" },
        "fee": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "factory": { "$ref": "#/$defs/address" },
        "deployed_block": { "type": "integer", "minimum": 0 },
        "derived_via": { "type": "string" },
        "coins": {
          "type": "array",
          "items": { "$ref": "#/$defs/address" },
          "minItems": 2,
          "maxItems": 4
        },
        "curve_d_once": { "type": "boolean" },
        "crypto_kind": {
          "description": "curve_crypto only: the deployed math the pool runs.",
          "type": "string",
          "enum": ["two_v1", "two_v200", "two_v210", "two_stable", "tri"]
        },
        "asset_types": {
          "description": "curve_ng only: each coin's NG asset_type (0 standard, 1 rate oracle, 3 ERC-4626). Rebasing (2) is not admitted.",
          "type": "array",
          "items": { "type": "integer", "enum": [0, 1, 3] },
          "minItems": 2,
          "maxItems": 4
        },
        "curve_handler": {
          "description": "Every Curve venue: index of the MetaRegistry handler that holds the pool (get_registry(i), whose is_registered(pool) is true). The Executor asks that one handler; every Curve leg carries this index.",
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      },
      "allOf": [
        {
          "if": { "properties": { "venue": { "enum": ["curve", "curve_ng", "curve_crypto"] } } },
          "then": { "required": ["coins", "curve_handler"] },
          "else": {
            "if": { "properties": { "venue": { "const": "balancer" } } },
            "then": { "required": ["coins", "pool_id", "balancer_kind"], "not": { "required": ["curve_handler"] } },
            "else": {
              "if": { "properties": { "venue": { "const": "fluid" } } },
              "then": { "required": ["coins"], "not": { "anyOf": [{ "required": ["curve_handler"] }, { "required": ["pool_id"] }, { "required": ["balancer_kind"] }] } },
              "else": { "not": { "anyOf": [{ "required": ["coins"] }, { "required": ["curve_handler"] }, { "required": ["pool_id"] }, { "required": ["balancer_kind"] }] } }
            }
          }
        },
        {
          "if": { "properties": { "venue": { "const": "curve_ng" } } },
          "then": { "required": ["asset_types"] },
          "else": { "not": { "required": ["asset_types"] } }
        },
        {
          "if": { "properties": { "venue": { "const": "curve_crypto" } } },
          "then": { "required": ["crypto_kind"] },
          "else": { "not": { "required": ["crypto_kind"] } }
        }
      ],
      "additionalProperties": false
    }
  }
}
