# Archives — the guides live as files, not zips
*.zip

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Rust build artifacts (when crates/ appears)
target/
**/*.rs.bk
**/proptest-regressions/   # proptest failing-seed cache (directory form); never commit (replayed before fresh cases)
**/*.proptest-regressions # proptest failing-seed cache (file form: tests/<name>.proptest-regressions); never commit
Cargo.lock.bak

# Editor / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Local env / secrets (never commit keys)
data/archive/**/*.parquet
.env
.env.local
*.key
*.pem
secrets/

# gas measurement tool cache (traces, discovered txs)
tools/gas-measure/cache/
tools/gas-measure/run.log
tools/gas-measure/report.out
tools/gas-measure/fork-trace*.txt
